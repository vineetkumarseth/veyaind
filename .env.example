# Is file ko .env naam se copy karo aur values bharo (.env git mein nahi jaati)
VEYA_MODEL=qwen3:8b
VEYA_THINK=0
# Google login (optional): Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: http://127.0.0.1:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Deploy karte waqt apna https domain likho, jaise https://getveya.in
VEYA_BASE_URL=http://127.0.0.1:8000
# Photo ke liye model (optional). Memory kam ho to halka: llava:latest
VEYA_VISION_MODEL=llava:latest
# Coding mode mein Veya apna Python code Mac par sandbox mein chalake check kare? (default 0 = band)
VEYA_ALLOW_RUN=0
# Dusron ko try karwane ke liye: signup par ye code maange (khali = sab ke liye khula)
VEYA_INVITE_CODE=
# Context window (tokens). Bada = lambi chat/PDF yaad, par zyada RAM
VEYA_CTX=8192
# Weather jaisi live cheezein (sirf shehar ka naam Open-Meteo ko jata hai). 0 = band
VEYA_WEB_TOOLS=1
# Shehar ka naam na likha ho tab ka default, jaise Kanpur
VEYA_CITY=
# Web search (optional, button 'Web' chat mein). Ek key chuno: Tavily (tavily.com) ya Serper (serper.dev)
TAVILY_API_KEY=
SERPER_API_KEY=
# Ek user ki roz ki search limit (kharcha control)
VEYA_WEB_LIMIT=30
# Web search is manual. 1 = users MAY turn on "search automatically" in Settings (off by default). 0 = remove that option.
VEYA_AUTO_WEB=1

# ---------- Credits and long messages ----------
# Chat credits per user per day (1 message = 1 credit). Blank or 0 = unlimited. Shows the credits counter in the sidebar.
VEYA_DAILY_CREDITS=
# Longest chat message in characters (default 12000). Keep it well under your context window (VEYA_CTX).
VEYA_MAX_MESSAGE=12000

# ---------- Models ----------
# Show only these models in the model menu (comma separated, blank = all installed). Does not delete anything.
VEYA_MODELS=
# Your own fine-tuned tutor model, used by the Code tutor mode (see tutor/README.md). Blank = use the main model.
VEYA_TUTOR_MODEL=

# VEYRA modes: only Core exists. To release Deep or Flash later, set its model and switch it on (blank = stays on the waitlist).
VEYA_DEEP_MODEL=
VEYA_MODE_DEEP=waitlist
VEYA_FLASH_MODEL=
VEYA_MODE_FLASH=waitlist

# ---------- Studio (Slides apne aap; image/music/video ke liye provider chuno) ----------
# Replicate (image, music, video teeno): replicate.com par token banao, model ka naam (owner/name) unke catalog se
REPLICATE_API_TOKEN=
VEYA_IMAGE_PROVIDER=
VEYA_IMAGE_MODEL=
VEYA_MUSIC_PROVIDER=
VEYA_MUSIC_MODEL=
VEYA_VIDEO_PROVIDER=
VEYA_VIDEO_MODEL=
# Model ko extra input chahiye to JSON, jaise VEYA_VIDEO_INPUT={"duration": 4}
# FREE image option: Cloudflare Workers AI (see SETUP_STUDIO.md). Set VEYA_IMAGE_PROVIDER=cloudflare and fill these two:
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# OpenAI (sirf image): VEYA_IMAGE_PROVIDER=openai, VEYA_IMAGE_MODEL=<model naam>, OPENAI_API_KEY=
OPENAI_API_KEY=
# Ek user ki roz ki limit (kharcha control)
VEYA_LIMIT_SLIDES=20
VEYA_LIMIT_IMAGE=10
VEYA_LIMIT_MUSIC=5
VEYA_LIMIT_VIDEO=2
# Server par database/key/media ka folder (Docker mein /data)
# VEYA_DATA_DIR=/data
